# ==== Chung ====
POSTGRES_USER=smartfashion
POSTGRES_PASSWORD=smartfashion
POSTGRES_DB=smartfashion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smartfashion:smartfashion@postgres:5432/smartfashion?schema=public

REDIS_URL=redis://redis:6379

# ==== Core Backend ====
CORE_BACKEND_PORT=4000
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES=7d
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000
RECOMMENDATION_TIMEOUT_MS=500

# Origin THẬT của storefront khi deploy (dùng để: (1) whitelist CORS, (2) đích redirect sau khi
# đăng nhập Google). Deploy local/dev để trống thì code tự fallback http://localhost:3000.
STOREFRONT_ORIGIN=
ADMIN_ORIGIN=

# Đăng nhập Google (OAuth 2.0) - để trống thì nút "Tiếp tục với Google" tự ẩn ở storefront, không
# bắt buộc phải cấu hình mới chạy được app. Tạo tại https://console.cloud.google.com/apis/credentials
# > Create OAuth client ID > Web application. Authorized redirect URI phải khớp CHÍNH XÁC
# GOOGLE_CALLBACK_URL bên dưới (vd sau khi deploy: https://<domain-backend-railway>/api/v1/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/v1/auth/google/callback

# Gửi email OTP xác thực khi đăng ký - để trống thì mã OTP được LOG RA CONSOLE server thay vì gửi
# mail thật (vẫn test được luồng đăng ký, chỉ là phải xem log thay vì hộp thư). Dùng được với bất
# kỳ SMTP nào: Gmail (bật "App password" tại myaccount.google.com/apppasswords), Resend SMTP
# (resend.com, free 100 mail/ngày), Mailtrap...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Lưu trữ ảnh sản phẩm - Railway không có ổ đĩa bền vững nên KHÔNG lưu ảnh local, bắt buộc dùng
# dịch vụ ngoài. Để trống thì admin dashboard sẽ báo lỗi khi tải ảnh lên (chưa cấu hình), các chức
# năng khác vẫn chạy bình thường. Tạo tài khoản free tại https://cloudinary.com > Dashboard để lấy
# 3 giá trị bên dưới.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== Recommendation Service ====
REC_SERVICE_PORT=8000
DATABASE_URL_SYNC=postgresql://smartfashion:smartfashion@postgres:5432/smartfashion

# ==== Storefront ====
STOREFRONT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==== Admin Dashboard ====
ADMIN_PORT=5173
VITE_API_URL=http://localhost:4000/api/v1
VITE_REC_SERVICE_URL=http://localhost:8000
